{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["es2021", "dom"],
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./distjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "src/*"]
    },
    "types": ["node"] 
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "distjs"
  ]
}